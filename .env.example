# Copy to .env and fill in. Never commit .env.

DJANGO_DEBUG=true
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
LOG_LEVEL=INFO

# Supabase Postgres. Dashboard -> your project -> Connect -> "Direct connection" (needs IPv6)
# or "Session pooler" (IPv4, port 5432). Don't use the transaction pooler (port 6543).
# URL-encode special characters in the password. Leave empty to use local SQLite.
DATABASE_URL=
DB_SSLMODE=require

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@localhost

INVENTORY_HOLD_MINUTES=15

# Razorpay TEST keys only (rzp_test_...). Dashboard -> Account & Settings -> API Keys (Test Mode).
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Keep false until every live-payment prerequisite in the spec is met.
PAYMENTS_LIVE_MODE=false

# Verified business facts. Leave blank until confirmed; pages show "not yet configured".
BUSINESS_LEGAL_ENTITY_NAME=
BUSINESS_REGISTERED_ADDRESS=
BUSINESS_SUPPORT_EMAIL=
BUSINESS_SUPPORT_PHONE=
BUSINESS_GRIEVANCE_OFFICER_NAME=
BUSINESS_GRIEVANCE_OFFICER_EMAIL=
# intermediary | marketplace | operator
BUSINESS_PLATFORM_ROLE=
